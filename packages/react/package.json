{
  "name": "@daniluk/liquid-glass-react",
  "version": "0.0.1",
  "description": "React components and hooks for @daniluk/liquid-glass — Apple-style liquid glass rendered with WebGL.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@daniluk/liquid-glass": "0.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "react",
    "liquid-glass",
    "glass",
    "glassmorphism",
    "webgl",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptu14/liquid-glass.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ptu14/liquid-glass/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/ptu14/liquid-glass/issues"
  },
  "author": "Mateusz Daniluk",
  "publishConfig": {
    "access": "public"
  }
}
