{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@daniluk/liquid-glass": ["./packages/core/src/index.ts"],
      "@daniluk/liquid-glass-react": ["./packages/react/src/index.ts"],
      "@daniluk/liquid-glass-angular": ["./packages/angular/src/public-api.ts"]
    }
  },
  "include": ["packages/*/src"],
  "exclude": ["node_modules", "**/dist"]
}
