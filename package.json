{
  "name": "liquid-glass-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Liquid glass for the web — WebGL core + React and Angular component libraries",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @daniluk/liquid-glass && npm run build -w @daniluk/liquid-glass-react && npm run build -w @daniluk/liquid-glass-angular",
    "build:core": "npm run build -w @daniluk/liquid-glass",
    "dev": "npm run dev -w @daniluk/liquid-glass",
    "typecheck": "tsc --noEmit",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:angular": "vite --config demo-angular/vite.config.ts",
    "demo:angular:build": "vite build --config demo-angular/vite.config.ts",
    "example:vanilla": "npm run build:core && vite examples/vanilla",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && npm publish -w @daniluk/liquid-glass -w @daniluk/liquid-glass-react && npm publish ./packages/angular/dist",
    "pages:build": "sh scripts/build-pages.sh"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.22.5",
    "@angular/build": "^19.2.22",
    "@angular/common": "^19.2.19",
    "@angular/compiler": "^19.2.19",
    "@angular/compiler-cli": "^19.2.19",
    "@angular/core": "^19.2.19",
    "@angular/forms": "19.2.19",
    "@angular/platform-browser": "^19.2.19",
    "@angular/platform-browser-dynamic": "^19.2.19",
    "@changesets/cli": "^2.29.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "ng-packagr": "^19.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "zone.js": "^0.15.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptu14/liquid-glass.git"
  }
}
